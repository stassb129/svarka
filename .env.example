# All variables are optional and PUBLIC (inlined into the client bundle at `next build`).
# In Docker/Coolify they must be available at BUILD time (Coolify: "Build Variable").

# Public site origin (no trailing slash). Used for canonical, sitemap, robots, Open Graph, JSON-LD.
# Defaults to https://metalshov.ru when unset.
NEXT_PUBLIC_SITE_URL=https://metalshov.ru

# Optional: host to serve /_next assets and public files from (no trailing slash).
# Leave empty for same-origin (recommended for self-hosting).
# On Vercel it defaults to the stable *.vercel.app alias when unset.
# NEXT_PUBLIC_ASSET_PREFIX=

# Optional: Search Console / Webmaster verification codes
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=
